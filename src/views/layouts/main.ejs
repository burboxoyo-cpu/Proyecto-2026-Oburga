<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Focus & Habits</title>
  
  <!-- Tailwind CSS & Lucide Icons via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Estilos Personalizados -->
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-slate-950 text-slate-100 font-sans antialiased flex selection:bg-indigo-500 selection:text-white">
  
  <!-- Sidebar Parcial -->
  <%- include('../partials/sidebar') %>

  <!-- Área Principal de Contenido -->
  <div class="flex-1 flex flex-col min-w-0 lg:pl-64 min-h-screen">
    <!-- Header Parcial -->
    <%- include('../partials/header') %>

    <!-- Contenido Dinámico de la Página -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto">
      <%- body %>
    </main>

    <!-- Footer Simple -->
    <footer class="py-4 px-6 text-center text-xs text-slate-500 border-t border-slate-900">
      Focus & Habits 2026 • Arquitectura MVC con SQLite y Micro-Objetivos Dinámicos
    </footer>
  </div>

  <!-- Modales Globales -->
  <%- include('../partials/modals') %>

  <!-- Scripts de la Aplicación -->
  <script src="/js/app.js"></script>
</body>
</html>
