<div class="bg-slate-900/90 border border-slate-800 hover:border-slate-700/90 rounded-2xl p-4 shadow-lg transition-all duration-200 flex flex-col justify-between" id="task-card-<%= task.id %>">
  <div>
    <!-- Encabezado de la Tarjeta de Tarea -->
    <div class="flex items-start justify-between gap-2 mb-2">
      <div class="flex flex-wrap items-center gap-1.5">
        <% if (task.priority === 'high') { %>
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-md bg-rose-500/15 text-rose-400 border border-rose-500/30">🔴 Alta</span>
        <% } else if (task.priority === 'medium') { %>
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-md bg-amber-500/15 text-amber-400 border border-amber-500/30">🟡 Media</span>
        <% } else { %>
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">🟢 Baja</span>
        <% } %>

        <% if (task.category_name) { %>
          <span class="text-[9px] font-semibold px-2 py-0.5 rounded-md" style="background-color: <%= task.category_color %>20; color: <%= task.category_color %>">
            <%= task.category_name %>
          </span>
        <% } %>
      </div>

      <div class="flex items-center gap-1">
        <button onclick="editTask(<%= task.id %>)" title="Editar Tarea" class="p-1 text-slate-400 hover:text-white rounded">
          <i data-lucide="edit-3" class="w-3 h-3"></i>
        </button>
        <button onclick="confirmDelete('task', <%= task.id %>, '<%= task.title %>')" title="Eliminar Tarea" class="p-1 text-slate-400 hover:text-rose-400 rounded">
          <i data-lucide="trash-2" class="w-3 h-3"></i>
        </button>
      </div>
    </div>

    <!-- Título y Descripción -->
    <h4 class="text-sm font-bold text-white tracking-tight mb-1 <%= task.status === 'completed' ? 'line-through text-slate-400' : '' %>">
      <%= task.title %>
    </h4>

    <% if (task.description) { %>
      <p class="text-xs text-slate-400 line-clamp-2 mb-3"><%= task.description %></p>
    <% } %>

    <!-- CHECKLIST DE MICRO-OBJETIVOS / SUB-TAREAS (100% EDITABLE) -->
    <div class="mt-3 pt-2.5 border-t border-slate-800/80">
      <div class="flex items-center justify-between text-[11px] mb-1.5">
        <span class="text-slate-400 font-medium flex items-center gap-1">
          <i data-lucide="list-checks" class="w-3 h-3 text-indigo-400"></i>
          <span>Micro-Objetivos (<%= task.checklist.completed %>/<%= task.checklist.total %>)</span>
        </span>
        <span class="font-bold text-indigo-400" id="task-pct-<%= task.id %>"><%= task.checklist.percentage %>%</span>
      </div>

      <!-- Barra de Progreso -->
      <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden mb-2.5">
        <div id="task-bar-<%= task.id %>" class="h-full bg-indigo-500 rounded-full transition-all duration-300" style="width: <%= task.checklist.percentage %>%"></div>
      </div>

      <!-- Lista de Micro-Objetivos de la Tarea -->
      <ul class="space-y-1" id="checklist-items-task-<%= task.id %>">
        <% task.checklist.items.forEach(item => { %>
          <li class="flex items-center justify-between gap-1.5 p-1.5 rounded-lg bg-slate-950/60 border border-slate-800/60 hover:border-slate-700 text-[11px] group" id="checkitem-<%= item.id %>">
            <label class="flex items-center gap-2 flex-1 min-w-0 cursor-pointer">
              <input type="checkbox" <%= item.is_completed ? 'checked' : '' %> 
                onchange="toggleChecklistItem(<%= item.id %>, 'task', <%= task.id %>)"
                class="w-3.5 h-3.5 rounded border-slate-700 text-indigo-600 focus:ring-indigo-500 bg-slate-800 cursor-pointer">
              <span id="checkitem-title-<%= item.id %>" class="text-slate-300 truncate <%= item.is_completed ? 'line-through text-slate-500' : '' %>">
                <%= item.title %>
              </span>
            </label>
            <div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
              <button onclick="inlineEditChecklistItem(<%= item.id %>, 'task', <%= task.id %>)" title="Editar texto" class="p-0.5 text-slate-400 hover:text-white rounded">
                <i data-lucide="edit-2" class="w-2.5 h-2.5"></i>
              </button>
              <button onclick="deleteChecklistItem(<%= item.id %>, 'task', <%= task.id %>)" title="Eliminar objetivo" class="p-0.5 text-slate-400 hover:text-rose-400 rounded">
                <i data-lucide="trash" class="w-2.5 h-2.5"></i>
              </button>
            </div>
          </li>
        <% }) %>
      </ul>

      <!-- Añadir sub-objetivo rápido -->
      <form onsubmit="addInlineCheckitem(event, 'task', <%= task.id %>)" class="flex gap-1.5 pt-1.5">
        <input type="text" placeholder="+ Añadir micro-objetivo..." required
          class="flex-1 bg-slate-950/50 border border-slate-800 rounded-lg px-2.5 py-1 text-[11px] text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500">
        <button type="submit" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white rounded-lg text-[11px] font-semibold transition-all">
          +
        </button>
      </form>
    </div>
  </div>

  <!-- Footer de Tarjeta: Fecha y Selector Rápido de Estado -->
  <div class="mt-3 pt-2.5 border-t border-slate-800/80 flex items-center justify-between text-xs">
    <div class="flex items-center gap-1 text-slate-400 text-[10px]">
      <i data-lucide="calendar" class="w-3 h-3"></i>
      <span><%= task.due_date ? task.due_date : 'Sin límite' %></span>
    </div>

    <select onchange="updateTaskStatusQuick(<%= task.id %>, this.value)" 
      class="bg-slate-800 border border-slate-700 text-[10px] text-slate-300 rounded-lg px-2 py-1 focus:outline-none focus:border-indigo-500">
      <option value="pending" <%= task.status === 'pending' ? 'selected' : '' %>>⏳ Pendiente</option>
      <option value="in_progress" <%= task.status === 'in_progress' ? 'selected' : '' %>>⚡ En progreso</option>
      <option value="completed" <%= task.status === 'completed' ? 'selected' : '' %>>✅ Hecho</option>
    </select>
  </div>
</div>
