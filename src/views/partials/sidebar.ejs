<aside id="appSidebar" class="fixed inset-y-0 left-0 z-40 w-64 bg-slate-900/95 backdrop-blur-xl border-r border-slate-800/80 flex flex-col transition-transform duration-300 -translate-x-full lg:translate-x-0">
  <!-- Brand Header -->
  <div class="h-16 flex items-center justify-between px-6 border-b border-slate-800/80">
    <a href="/dashboard" class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-400 flex items-center justify-center shadow-lg shadow-indigo-600/30">
        <i data-lucide="check-check" class="w-5 h-5 text-white"></i>
      </div>
      <div>
        <span class="font-bold text-base text-white tracking-tight">Focus & Habits</span>
        <span class="block text-[10px] text-indigo-400 font-medium tracking-wider uppercase">MVC v1.0</span>
      </div>
    </a>
    <button id="closeSidebarBtn" class="lg:hidden text-slate-400 hover:text-white p-1">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>
  </div>

  <!-- Navigation Menu -->
  <nav class="flex-1 overflow-y-auto px-4 py-6 space-y-1.5 custom-scrollbar">
    <div class="px-3 pb-2 text-[11px] font-semibold tracking-wider text-slate-400 uppercase">Menú Principal</div>

    <a href="/dashboard" 
      class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all <%= currentPath === '/dashboard' ? 'bg-indigo-600/15 text-indigo-400 border border-indigo-500/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
      <i data-lucide="layout-dashboard" class="w-4 h-4 <%= currentPath === '/dashboard' ? 'text-indigo-400' : 'text-slate-400' %>"></i>
      <span>Panel Principal</span>
    </a>

    <a href="/habits" 
      class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all <%= currentPath === '/habits' ? 'bg-indigo-600/15 text-indigo-400 border border-indigo-500/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
      <i data-lucide="flame" class="w-4 h-4 <%= currentPath === '/habits' ? 'text-indigo-400' : 'text-slate-400' %>"></i>
      <span>Mis Hábitos</span>
    </a>

    <a href="/tasks" 
      class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all <%= currentPath === '/tasks' ? 'bg-indigo-600/15 text-indigo-400 border border-indigo-500/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
      <i data-lucide="check-square" class="w-4 h-4 <%= currentPath === '/tasks' ? 'text-indigo-400' : 'text-slate-400' %>"></i>
      <span>Mis Tareas</span>
    </a>

    <a href="/stats" 
      class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all <%= currentPath === '/stats' ? 'bg-indigo-600/15 text-indigo-400 border border-indigo-500/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
      <i data-lucide="bar-chart-2" class="w-4 h-4 <%= currentPath === '/stats' ? 'text-indigo-400' : 'text-slate-400' %>"></i>
      <span>Estadísticas</span>
    </a>

    <div class="pt-6 px-3 pb-2 text-[11px] font-semibold tracking-wider text-slate-400 uppercase">Acciones Rápidas</div>

    <button onclick="openHabitModal()" 
      class="w-full flex items-center gap-3 px-3.5 py-2 rounded-xl text-xs font-medium text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 transition-all text-left">
      <i data-lucide="plus-circle" class="w-4 h-4"></i>
      <span>Nuevo Hábito</span>
    </button>

    <button onclick="openTaskModal()" 
      class="w-full flex items-center gap-3 px-3.5 py-2 rounded-xl text-xs font-medium text-indigo-400 bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/20 transition-all text-left mt-2">
      <i data-lucide="plus-circle" class="w-4 h-4"></i>
      <span>Nueva Tarea</span>
    </button>
  </nav>

  <!-- User Card Footer -->
  <div class="p-4 border-t border-slate-800/80 bg-slate-900/50">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-md">
          <%= currentUser ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold text-white truncate"><%= currentUser ? currentUser.name : 'Usuario' %></p>
          <div class="flex items-center gap-1">
            <span class="inline-block w-1.5 h-1.5 rounded-full <%= currentUser && currentUser.role === 'admin' ? 'bg-amber-400' : 'bg-emerald-400' %>"></span>
            <span class="text-[10px] text-slate-400 uppercase tracking-wider"><%= currentUser ? currentUser.role : 'user' %></span>
          </div>
        </div>
      </div>
      <a href="/logout" title="Cerrar Sesión" 
        class="p-2 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-all">
        <i data-lucide="log-out" class="w-4 h-4"></i>
      </a>
    </div>
  </div>
</aside>

<!-- Overlay móvil -->
<div id="sidebarOverlay" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-30 hidden lg:hidden"></div>
