<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Focus & Habits</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="h-full bg-slate-950 text-slate-100 font-sans antialiased flex selection:bg-indigo-500 selection:text-white">
  
  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col min-w-0 lg:pl-64 min-h-screen">
    <%- include('../partials/header') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
      
      <!-- Encabezado de Página y Filtros de Categoría -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-extrabold text-white tracking-tight">Registro de Hábitos</h2>
          <p class="text-slate-400 text-xs mt-1">Monitorea tu constancia, rachas y micro-objetivos diarios</p>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="openHabitModal()" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-emerald-600/30 transition-all flex items-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Nuevo Hábito</span>
          </button>
        </div>
      </div>

      <!-- Filtros por Categoría -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 custom-scrollbar">
        <a href="/habits" 
          class="px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all shrink-0 <%= selectedCategory === 'all' ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/25' : 'bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800' %>">
          Todos los hábitos
        </a>
        <% categories.forEach(cat => { %>
          <a href="/habits?category=<%= cat.id %>" 
            class="px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all shrink-0 flex items-center gap-1.5 <%= String(selectedCategory) === String(cat.id) ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/25' : 'bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800' %>">
            <span class="w-2 h-2 rounded-full" style="background-color: <%= cat.color %>"></span>
            <span><%= cat.name %></span>
          </a>
        <% }) %>
      </div>

      <!-- Lista de Hábitos -->
      <% if (habits.length === 0) { %>
        <div class="text-center py-16 bg-slate-900/60 border border-dashed border-slate-800 rounded-3xl p-8">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mx-auto mb-4 border border-emerald-500/20">
            <i data-lucide="flame" class="w-8 h-8"></i>
          </div>
          <h3 class="text-base font-bold text-white mb-1">No hay hábitos en esta categoría</h3>
          <p class="text-xs text-slate-400 mb-6 max-w-sm mx-auto">Crea un hábito nuevo y desglósalo en pequeños objetivos para construir una rutina sólida.</p>
          <button onclick="openHabitModal()" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-emerald-600/30">
            Crear Hábito Ahora
          </button>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <% habits.forEach(habit => { %>
            <div class="bg-slate-900/80 border border-slate-800/90 hover:border-slate-700/80 rounded-3xl p-6 shadow-xl backdrop-blur-sm transition-all duration-200 flex flex-col justify-between" id="habit-card-<%= habit.id %>">
              
              <!-- Cabecera del Hábito -->
              <div>
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 shadow-md" style="background-color: <%= habit.color %>20; color: <%= habit.color %>; border: 1px solid <%= habit.color %>40">
                      <i data-lucide="<%= habit.icon || 'flame' %>" class="w-6 h-6"></i>
                    </div>
                    <div>
                      <h3 class="text-base font-bold text-white tracking-tight"><%= habit.title %></h3>
                      <div class="flex items-center gap-2 mt-1">
                        <% if (habit.category_name) { %>
                          <span class="text-[10px] font-semibold px-2.5 py-0.5 rounded-full" style="background-color: <%= habit.category_color %>20; color: <%= habit.category_color %>">
                            <%= habit.category_name %>
                          </span>
                        <% } %>
                        <span class="text-[10px] text-slate-400 bg-slate-800 px-2 py-0.5 rounded-full">
                          <%= habit.frequency === 'daily' ? 'Diario' : (habit.frequency === 'weekdays' ? 'Lun-Vie' : (habit.frequency === 'weekends' ? 'Sáb-Dom' : 'Semanal')) %>
                        </span>
                      </div>
                    </div>
                  </div>

                  <!-- Botón Principal de Cumplimiento Hoy -->
                  <button onclick="toggleHabitLog(<%= habit.id %>)" 
                    id="habit-toggle-btn-<%= habit.id %>"
                    class="w-11 h-11 rounded-2xl flex items-center justify-center transition-all shrink-0 <%= habit.completedToday ? 'bg-emerald-500 text-white shadow-lg shadow-emerald-500/30' : 'bg-slate-800 text-slate-400 hover:bg-slate-700 hover:text-white border border-slate-700' %>">
                    <i data-lucide="check" class="w-6 h-6"></i>
                  </button>
                </div>

                <% if (habit.description) { %>
                  <p class="text-xs text-slate-300 mb-4 bg-slate-950/40 p-3 rounded-xl border border-slate-800/60"><%= habit.description %></p>
                <% } %>

                <!-- Estadísticas de Racha y Constancia Semanal (7 días) -->
                <div class="bg-slate-950/50 rounded-2xl p-3.5 border border-slate-800/80 mb-4">
                  <div class="flex items-center justify-between text-xs mb-3">
                    <div class="flex items-center gap-1.5 text-amber-400 font-bold">
                      <i data-lucide="flame" class="w-4 h-4 fill-amber-400/20"></i>
                      <span>Racha actual: <%= habit.streak %> días</span>
                    </div>
                    <span class="text-[11px] text-slate-400 font-medium">Mejor racha: <strong class="text-slate-200"><%= habit.longestStreak %></strong> d</span>
                  </div>

                  <!-- Burbujas de los últimos 7 días -->
                  <div class="flex items-center justify-between gap-1.5 pt-1">
                    <% habit.weeklyHistory.forEach(day => { %>
                      <button onclick="toggleHabitLogDate(<%= habit.id %>, '<%= day.date %>')"
                        title="<%= day.date %>: <%= day.isCompleted ? 'Completado' : 'No registrado' %>"
                        class="flex-1 flex flex-col items-center gap-1 py-1.5 rounded-xl border transition-all <%= day.isCompleted ? 'bg-emerald-500/20 border-emerald-500/40 text-emerald-400' : 'bg-slate-900 border-slate-800 text-slate-500 hover:border-slate-700' %> <%= day.isToday ? 'ring-2 ring-indigo-500/50' : '' %>">
                        <span class="text-[9px] font-bold uppercase"><%= day.dayName %></span>
                        <div class="w-2 h-2 rounded-full <%= day.isCompleted ? 'bg-emerald-400 shadow-sm shadow-emerald-400' : 'bg-slate-700' %>"></div>
                      </button>
                    <% }) %>
                  </div>
                </div>

                <!-- CHECKLIST DE MICRO-OBJETIVOS ANIDADOS (100% EDITABLE INLINE) -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
                      <i data-lucide="list-checks" class="w-3.5 h-3.5 text-emerald-400"></i>
                      <span>Micro-Objetivos (<%= habit.checklist.completed %>/<%= habit.checklist.total %>)</span>
                    </span>
                    <span class="text-xs font-bold text-emerald-400" id="habit-pct-<%= habit.id %>"><%= habit.checklist.percentage %>%</span>
                  </div>

                  <!-- Barra de Progreso -->
                  <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden mb-3">
                    <div id="habit-bar-<%= habit.id %>" class="h-full bg-gradient-to-r from-emerald-500 to-indigo-500 rounded-full transition-all duration-300" style="width: <%= habit.checklist.percentage %>%"></div>
                  </div>

                  <!-- Lista interactiva de Micro-Objetivos -->
                  <ul class="space-y-1.5" id="checklist-items-habit-<%= habit.id %>">
                    <% habit.checklist.items.forEach(item => { %>
                      <li class="flex items-center justify-between gap-2 p-2 rounded-xl bg-slate-950/60 border border-slate-800/80 hover:border-slate-700 text-xs transition-all group" id="checkitem-<%= item.id %>">
                        <label class="flex items-center gap-2.5 flex-1 min-w-0 cursor-pointer">
                          <input type="checkbox" <%= item.is_completed ? 'checked' : '' %> 
                            onchange="toggleChecklistItem(<%= item.id %>, 'habit', <%= habit.id %>)"
                            class="w-4 h-4 rounded border-slate-700 text-emerald-600 focus:ring-emerald-500 bg-slate-800 cursor-pointer">
                          <span id="checkitem-title-<%= item.id %>" class="text-slate-300 truncate <%= item.is_completed ? 'line-through text-slate-500' : '' %>">
                            <%= item.title %>
                          </span>
                        </label>
                        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                          <button onclick="inlineEditChecklistItem(<%= item.id %>, 'habit', <%= habit.id %>)" title="Editar texto" class="p-1 text-slate-400 hover:text-white rounded">
                            <i data-lucide="edit-2" class="w-3 h-3"></i>
                          </button>
                          <button onclick="deleteChecklistItem(<%= item.id %>, 'habit', <%= habit.id %>)" title="Eliminar objetivo" class="p-1 text-slate-400 hover:text-rose-400 rounded">
                            <i data-lucide="trash" class="w-3 h-3"></i>
                          </button>
                        </div>
                      </li>
                    <% }) %>
                  </ul>

                  <!-- Añadir micro-objetivo rápido inline -->
                  <form onsubmit="addInlineCheckitem(event, 'habit', <%= habit.id %>)" class="flex gap-2 pt-1">
                    <input type="text" placeholder="+ Añadir nuevo micro-objetivo..." required
                      class="flex-1 bg-slate-950/50 border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500">
                    <button type="submit" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-xs font-semibold transition-all">
                      Añadir
                    </button>
                  </form>
                </div>
              </div>

              <!-- Footer de la tarjeta: Acciones de edición del hábito -->
              <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
                <span class="text-[11px] text-slate-500">Meta: <%= habit.target_days %> vez al día</span>
                <div class="flex items-center gap-2">
                  <button onclick="editHabit(<%= habit.id %>)" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white rounded-xl text-xs font-medium transition-all flex items-center gap-1.5">
                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                    <span>Editar</span>
                  </button>
                  <button onclick="confirmDelete('habit', <%= habit.id %>, '<%= habit.title %>')" class="p-1.5 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-xl transition-colors">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                </div>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>

    </main>

    <footer class="py-4 px-6 text-center text-xs text-slate-500 border-t border-slate-900">
      Focus & Habits 2026 • Arquitectura MVC con SQLite
    </footer>
  </div>

  <%- include('../partials/modals') %>

  <script src="/js/app.js"></script>
</body>
</html>
