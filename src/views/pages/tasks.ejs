<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Focus & Habits</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="h-full bg-slate-950 text-slate-100 font-sans antialiased flex selection:bg-indigo-500 selection:text-white">
  
  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col min-w-0 lg:pl-64 min-h-screen">
    <%- include('../partials/header') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
      
      <!-- Encabezado de Página -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-extrabold text-white tracking-tight">Gestión de Tareas</h2>
          <p class="text-slate-400 text-xs mt-1">Organiza proyectos con fechas límites, prioridades y micro-objetivos</p>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="openTaskModal()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-indigo-600/30 transition-all flex items-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Nueva Tarea</span>
          </button>
        </div>
      </div>

      <!-- Barra de Filtros y Búsqueda -->
      <form action="/tasks" method="GET" class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 shadow-lg flex flex-wrap items-center gap-3">
        <!-- Input de Búsqueda -->
        <div class="flex-1 min-w-[200px] relative">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
          <input type="text" name="search" value="<%= currentFilters.search %>" placeholder="Buscar por título o descripción..."
            class="w-full bg-slate-800/80 border border-slate-700/80 rounded-xl pl-10 pr-4 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500">
        </div>

        <!-- Filtro Prioridad -->
        <div class="w-36">
          <select name="priority" onchange="this.form.submit()" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500">
            <option value="all" <%= currentFilters.priority === 'all' ? 'selected' : '' %>>Todas Prioridades</option>
            <option value="high" <%= currentFilters.priority === 'high' ? 'selected' : '' %>>🔴 Alta</option>
            <option value="medium" <%= currentFilters.priority === 'medium' ? 'selected' : '' %>>🟡 Media</option>
            <option value="low" <%= currentFilters.priority === 'low' ? 'selected' : '' %>>🟢 Baja</option>
          </select>
        </div>

        <!-- Filtro Categoría -->
        <div class="w-40">
          <select name="category" onchange="this.form.submit()" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500">
            <option value="all" <%= currentFilters.category === 'all' ? 'selected' : '' %>>Todas Categorías</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= String(currentFilters.category) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          </select>
        </div>

        <!-- Botón Limpiar Filtros -->
        <% if (currentFilters.search || currentFilters.priority !== 'all' || currentFilters.category !== 'all') { %>
          <a href="/tasks" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium rounded-xl transition-all">
            Limpiar
          </a>
        <% } %>
      </form>

      <!-- TABLERO KANBAN DE 3 COLUMNAS -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- COLUMNA 1: PENDIENTES -->
        <div class="flex flex-col space-y-4">
          <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-900/90 border border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
              <h3 class="text-xs font-bold text-white uppercase tracking-wider">Pendientes</h3>
            </div>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-800 text-amber-400"><%= kanban.pending.length %></span>
          </div>

          <div class="space-y-3 flex-1 min-h-[200px]">
            <% if (kanban.pending.length === 0) { %>
              <div class="text-center py-8 border border-dashed border-slate-800 rounded-2xl text-slate-600 text-xs">
                No hay tareas pendientes
              </div>
            <% } %>
            <% kanban.pending.forEach(task => { %>
              <%- include('../partials/task_card', { task }) %>
            <% }) %>
          </div>
        </div>

        <!-- COLUMNA 2: EN PROGRESO -->
        <div class="flex flex-col space-y-4">
          <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-900/90 border border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-400 animate-pulse"></span>
              <h3 class="text-xs font-bold text-white uppercase tracking-wider">En Progreso</h3>
            </div>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-800 text-blue-400"><%= kanban.in_progress.length %></span>
          </div>

          <div class="space-y-3 flex-1 min-h-[200px]">
            <% if (kanban.in_progress.length === 0) { %>
              <div class="text-center py-8 border border-dashed border-slate-800 rounded-2xl text-slate-600 text-xs">
                No hay tareas en progreso
              </div>
            <% } %>
            <% kanban.in_progress.forEach(task => { %>
              <%- include('../partials/task_card', { task }) %>
            <% }) %>
          </div>
        </div>

        <!-- COLUMNA 3: COMPLETADAS -->
        <div class="flex flex-col space-y-4">
          <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-900/90 border border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              <h3 class="text-xs font-bold text-white uppercase tracking-wider">Completadas</h3>
            </div>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-800 text-emerald-400"><%= kanban.completed.length %></span>
          </div>

          <div class="space-y-3 flex-1 min-h-[200px]">
            <% if (kanban.completed.length === 0) { %>
              <div class="text-center py-8 border border-dashed border-slate-800 rounded-2xl text-slate-600 text-xs">
                No hay tareas completadas
              </div>
            <% } %>
            <% kanban.completed.forEach(task => { %>
              <%- include('../partials/task_card', { task }) %>
            <% }) %>
          </div>
        </div>

      </div>

    </main>

    <footer class="py-4 px-6 text-center text-xs text-slate-500 border-t border-slate-900">
      Focus & Habits 2026 • Arquitectura MVC con SQLite
    </footer>
  </div>

  <%- include('../partials/modals') %>

  <script src="/js/app.js"></script>
</body>
</html>
